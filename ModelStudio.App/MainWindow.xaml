<Window x:Class="ModelStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModelStudio IDE — Visual Model &amp; GGUF Architecture Inspector" 
        Height="760" Width="1280" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="{DynamicResource BrushMainBg}" Foreground="#FFFFFF">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DYNAMIC STUDIO THEME BRUSHES -->
        <SolidColorBrush x:Key="BrushMainBg" Color="#0B0D14"/>
        <SolidColorBrush x:Key="BrushPanelBg" Color="#141923"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#1E2430"/>
        <SolidColorBrush x:Key="BrushPrimaryAccent" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="BrushSecondaryAccent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#262C3A"/>

        <!-- DATAGRID COLUMN HEADER STYLE -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- COMBOBOX ITEM STYLE & TEMPLATE -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimaryAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX STYLE & TEMPLATE -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BrushPanelBg}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"/>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0 Z" Fill="{DynamicResource BrushSecondaryAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,6,30,6" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="{DynamicResource BrushPanelBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SIDEBAR NAV BUTTON STYLE -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushMainBg}">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM TITLEBAR -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬡ ModelStudio IDE" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryAccent}"/>
                    <Border Background="{DynamicResource BrushBorder}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0 Pro" FontSize="11" Foreground="#10B981" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="─" Click="BtnMinimize_Click" Width="36" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="🗖" Click="BtnMaximize_Click" Width="36" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✕" Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- TOP ACTION TOOLBAR -->
            <Border Grid.Row="1" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnOpenModel" Click="BtnOpenModel_Click" 
                                Background="{DynamicResource BrushPrimaryAccent}" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 Open Model (.gguf)" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSaveModel" Click="BtnSaveModel_Click" Margin="8,0,0,0"
                                Background="#10B981" Foreground="White" FontWeight="Bold" Padding="14,8" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 Export Modified Model" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="TxtModelTitle" Text="No Model Loaded" FontSize="17" FontWeight="Bold" Foreground="#EC4899" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeArch" Background="{DynamicResource BrushBorder}" CornerRadius="4" Padding="8,4" Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtArchName" Text="gemma4" FontSize="12" Foreground="{DynamicResource BrushSecondaryAccent}" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <!-- Theme Selector & Search Box -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎨 Theme:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="ComboTheme" SelectionChanged="ComboTheme_SelectionChanged" Background="{DynamicResource BrushMainBg}" Foreground="White" Width="150" Margin="0,0,12,0" Padding="6">
                            <ComboBoxItem Content="Cyberpunk Neon" IsSelected="True"/>
                            <ComboBoxItem Content="Obsidian Dark"/>
                            <ComboBoxItem Content="Emerald Studio"/>
                            <ComboBoxItem Content="Clean Dark Slate"/>
                        </ComboBox>

                        <TextBlock Text="🔍 Filter Tensors:" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearch" Width="180" Padding="6" Background="{DynamicResource BrushMainBg}" Foreground="White" 
                                 BorderBrush="{DynamicResource BrushBorder}" TextChanged="TxtSearch_TextChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN WORKSPACE LAYOUT: LEFT SIDEBAR NAVIGATION + RIGHT CONTENT CANVAS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR NAVIGATION DRAWER -->
                <Border Grid.Column="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- CATEGORY 1: ARCHITECTURE & TENSORS -->
                            <TextBlock Text="ARCHITECTURE &amp; TENSORS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryAccent}" Margin="8,4,0,6"/>
                            <Button x:Name="NavTensors" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="0" Background="{DynamicResource BrushPrimaryAccent}" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕸️ Model Layer Graph" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavArchGraph" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎨 2D Architecture Canvas"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavHeader" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝 Header Metadata"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavLora" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧩 LoRA Workbench"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BrushBorder}" Margin="4,8"/>

                            <!-- CATEGORY 2: QUANTIZATION & QUALITY -->
                            <TextBlock Text="QUANTIZATION &amp; BENCHMARKS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushSecondaryAccent}" Margin="8,4,0,6"/>
                            <Button x:Name="NavQuant" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ GGUF Precision Quantizer"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavQuality" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 Quality &amp; Perplexity"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavVram" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="11">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾 VRAM &amp; Memory Estimator"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavProfiler" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱️ Layer Latency Profiler"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BrushBorder}" Margin="4,8"/>

                            <!-- CATEGORY 3: DEPLOYMENT & PUBLISHING -->
                            <TextBlock Text="PUBLISHING &amp; DEPLOYMENT" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="8,4,0,6"/>
                            <Button x:Name="NavOllama" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀 1-Click Ollama Deployer"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavHf" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🤗 HuggingFace Publisher"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavBrowser" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥 HuggingFace Model Browser"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavMerge" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔀 FrankenMerge &amp; Splitter"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavDiff" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 Checkpoint Diff Viewer"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="{DynamicResource BrushBorder}" Margin="4,8"/>

                            <!-- CATEGORY 4: PLAYGROUND & TESTING -->
                            <TextBlock Text="PLAYGROUND &amp; TESTING" FontSize="11" FontWeight="Bold" Foreground="#EC4899" Margin="8,4,0,6"/>
                            <Button x:Name="NavToken" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧪 Tokenizer Playground"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NavInfer" Style="{StaticResource NavButtonStyle}" Click="Nav_Click" Tag="9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬 Model Playground"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- RIGHT MAIN CONTENT CANVAS (SWAPPABLE VIEWS) -->
                <Grid Grid.Column="1">
                    <!-- VIEW 0: MODEL LAYER GRAPH & TENSORS -->
                    <Grid x:Name="ViewTensors" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL: SUMMARY & QUANTS -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="📊 Model Summary" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryAccent}" Margin="0,0,0,10"/>

                                    <Border Background="{DynamicResource BrushMainBg}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtMetaContext" Text="Context Length: --" FontSize="13" Foreground="White" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtMetaTensors" Text="Total Tensors: --" FontSize="13" Foreground="White" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtMetaParams" Text="Total Parameters: --" FontSize="13" Foreground="#10B981" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="🎛️ Quantization Formats" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushSecondaryAccent}" Margin="0,0,0,8"/>
                                    <ListBox x:Name="ListQuants" Background="{DynamicResource BrushMainBg}" Foreground="White" BorderBrush="{DynamicResource BrushBorder}" Height="220" Margin="0,0,0,14"/>

                                    <TextBlock Text="💡 Quick Actions" FontSize="15" FontWeight="Bold" Foreground="#EC4899" Margin="0,0,0,8"/>
                                    <Button Content="⚡ Add Custom Metadata Key" Click="BtnAddMeta_Click" Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource BrushBorder}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    <Button Content="🧹 Prune Unused Tensors" Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource BrushBorder}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- CENTER GRID: TENSOR TABLE -->
                        <Border Grid.Column="1" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="12" Margin="6,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="🕸️ Model Layer &amp; Tensor Pipeline" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                    <TextBlock x:Name="TxtTensorCount" Text="(0 tensors)" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1" x:Name="GridTensors" AutoGenerateColumns="False" IsReadOnly="True" 
                                          Background="{DynamicResource BrushMainBg}" Foreground="White" RowBackground="{DynamicResource BrushMainBg}" 
                                          AlternatingRowBackground="#121620" BorderBrush="{DynamicResource BrushBorder}" 
                                          ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          SelectionChanged="GridTensors_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tensor Name" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="Dimensions" Binding="{Binding DimensionString}" Width="140"/>
                                        <DataGridTextColumn Header="Quant Type" Binding="{Binding Type}" Width="100"/>
                                        <DataGridTextColumn Header="Elements" Binding="{Binding TotalElements, StringFormat={}{0:N0}}" Width="120"/>
                                        <DataGridTextColumn Header="File Offset" Binding="{Binding Offset, StringFormat=0x{0:X8}}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- RIGHT PANEL: TENSOR INSPECTOR & EDIT TUNER -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🔍 Selected Tensor Inspector" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource BrushMainBg}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                    <StackPanel x:Name="PanelTensorInfo">
                                        <TextBlock x:Name="TxtSelectedName" Text="Select a tensor from grid" FontSize="13" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtSelectedShape" Text="Shape: --" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtSelectedQuant" Text="Quantization: --" FontSize="12" Foreground="{DynamicResource BrushSecondaryAccent}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtSelectedElements" Text="Total Elements: --" FontSize="12" Foreground="#10B981" Margin="0,0,0,4"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="🎛️ Layer Precision Override" FontSize="15" FontWeight="Bold" Foreground="#EC4899" Margin="0,0,0,8"/>
                                <TextBlock Text="Select new quantization format for this layer:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboLayerPrecision" Background="{DynamicResource BrushMainBg}" Foreground="White" Margin="0,0,0,12" Padding="8">
                                    <ComboBoxItem Content="IQ4_XS (Non-Linear Quant)" IsSelected="True"/>
                                    <ComboBoxItem Content="Q4_K_M (Medium Quant)"/>
                                    <ComboBoxItem Content="Q6_K (High Quality)"/>
                                    <ComboBoxItem Content="Q8_0 (Near Lossless)"/>
                                    <ComboBoxItem Content="FP16 (Full Precision)"/>
                                </ComboBox>

                                <Button Content="⚡ Apply Precision Rule" Click="BtnApplyPrecision_Click" Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource BrushPrimaryAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="✂️ Prune Selected Layer Block" Click="BtnPruneLayer_Click" Margin="0,0,0,14" Padding="10,8" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

                                <TextBlock Text="📊 Raw Weight Inspection Matrix" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,10,0,8"/>
                                <DataGrid x:Name="GridTensorWeights" AutoGenerateColumns="False" IsReadOnly="False" 
                                          Background="{DynamicResource BrushMainBg}" Foreground="White" RowBackground="{DynamicResource BrushMainBg}" 
                                          AlternatingRowBackground="#121620" BorderBrush="{DynamicResource BrushBorder}" Height="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="80" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Weight Value (Editable)" Binding="{Binding Value, StringFormat={}{0:F6}}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VIEW 1: HEADER METADATA -->
                    <Grid x:Name="ViewHeader" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📝 Interactive Header &amp; Key-Value Editor" FontSize="16" FontWeight="Bold" Foreground="#EC4899"/>
                            <TextBlock Text="(Select any metadata key to view and edit full value/template in right panel)" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- PRIMARY HEADER ATTRIBUTE EDITORS -->
                        <Border Grid.Row="1" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Model Name (general.name)" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EditModelName" Padding="6" Background="{DynamicResource BrushMainBg}" Foreground="White" BorderBrush="{DynamicResource BrushBorder}" TextChanged="EditHeaderProp_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                    <TextBlock Text="Architecture (general.architecture)" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
