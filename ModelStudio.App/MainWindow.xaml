                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="💾 Live VRAM &amp; Memory Calculator" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushSecondaryAccent}" Margin="0,0,0,10"/>

                                <Button Content="⚡ Calculate Current Model Footprint" Click="BtnCalcVram_Click" Padding="12,10" Background="{DynamicResource BrushSecondaryAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14"/>

                                <Border Background="{DynamicResource BrushMainBg}" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtVramWeights" Text="Model Weights VRAM: -- GB" FontSize="14" Foreground="#10B981" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtVram4k" Text="KV Cache (4k Context): -- GB" FontSize="13" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtVram32k" Text="KV Cache (32k Context): -- GB" FontSize="13" Foreground="White" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtVram128k" Text="KV Cache (128k Context): -- GB" FontSize="13" Foreground="#F59E0B" Margin="0,0,0,8"/>
                                        <Separator Background="{DynamicResource BrushBorder}" Margin="0,4,0,8"/>
                                        <TextBlock x:Name="TxtVramTotal" Text="Total Recommended VRAM: -- GB" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryAccent}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="📊 Hardware Memory Allocation Guidelines" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                                <TextBox Grid.Row="1" x:Name="TxtVramGuideLog" IsReadOnly="True" TextWrapping="Wrap" Background="{DynamicResource BrushMainBg}" Foreground="#10B981" FontFamily="Consolas" FontSize="12" Padding="10" BorderBrush="{DynamicResource BrushBorder}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VIEW 12: 2D ARCHITECTURE NODE CANVAS -->
                    <Grid x:Name="ViewArchGraph" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🎨 Render 2D Transformer Canvas" Click="BtnRenderArchGraph_Click" Padding="12,8" Background="{DynamicResource BrushPrimaryAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock Text="Interactive node visualizer (Emerald: IQ4_XS | Cyan: Q6_K | Magenta: FP16)" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource BrushMainBg}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource BrushBorder}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Canvas x:Name="CanvasArchNodes" Width="2000" Height="600" Background="#0D111A"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- VIEW 13: LAYER LATENCY & BANDWIDTH PROFILER -->
                    <Grid x:Name="ViewProfiler" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⏱️ Run Hardware Latency Profiler" Click="BtnRunProfiler_Click" Padding="12,8" Background="{DynamicResource BrushSecondaryAccent}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock Text="Target Bandwidth:" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="16,0,6,0"/>
                                <TextBox x:Name="EditProfilerBandwidth" Text="200" Width="60" Padding="4" Background="{DynamicResource BrushMainBg}" Foreground="White" BorderBrush="{DynamicResource BrushBorder}"/>
                                <TextBlock Text="GB/s" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="GridProfilerResults" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="{DynamicResource BrushMainBg}" Foreground="White" RowBackground="{DynamicResource BrushMainBg}" 
                                  AlternatingRowBackground="#121620" BorderBrush="{DynamicResource BrushBorder}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Layer Block / Tensor Name" Binding="{Binding LayerName}" Width="320"/>
                                <DataGridTextColumn Header="Precision Type" Binding="{Binding Type}" Width="120"/>
                                <DataGridTextColumn Header="Parameters" Binding="{Binding TotalElements, StringFormat={}{0:N0}}" Width="140"/>
                                <DataGridTextColumn Header="Size (MB)" Binding="{Binding MemorySizeMb, StringFormat={}{0:F2}}" Width="120"/>
                                <DataGridTextColumn Header="Est. Latency (ms)" Binding="{Binding EstimatedLatencyMs, StringFormat={}{0:F4}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- VIEW 14: HUGGINGFACE MODEL BROWSER -->
                    <Grid x:Name="ViewBrowser" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Search HuggingFace Hub:" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="EditHfSearchQuery" Text="gguf" Width="220" Padding="6" Background="{DynamicResource BrushMainBg}" Foreground="White" BorderBrush="{DynamicResource BrushBorder}"/>
                                <Button Content="🔍 Search Hub" Click="BtnSearchHf_Click" Padding="12,6" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="380"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0" x:Name="GridHfSearchResults" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="{DynamicResource BrushMainBg}" Foreground="White" RowBackground="{DynamicResource BrushMainBg}" 
                                      AlternatingRowBackground="#121620" BorderBrush="{DynamicResource BrushBorder}" Margin="0,0,6,0"
                                      SelectionChanged="GridHfSearchResults_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Repository ID" Binding="{Binding RepoId}" Width="280"/>
                                    <DataGridTextColumn Header="Model Name" Binding="{Binding ModelName}" Width="180"/>
                                    <DataGridTextColumn Header="Downloads" Binding="{Binding Downloads, StringFormat={}{0:N0}}" Width="120"/>
                                    <DataGridTextColumn Header="Likes" Binding="{Binding Likes, StringFormat={}{0:N0}}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Column="1" Background="{DynamicResource BrushPanelBg}" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📥 Direct Model Downloader" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="TxtSelectedHfRepo" Text="Select a model from search results" FontSize="13" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                                    <TextBlock Text="Direct GGUF URL:" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                                    <TextBox x:Name="EditGgufDirectUrl" Padding="6" Background="{DynamicResource BrushMainBg}" Foreground="White" BorderBrush="{DynamicResource BrushBorder}" Margin="0,0,0,12"/>

                                    <Button Content="⚡ Download Model File" Click="BtnStartDownload_Click" Padding="12,10" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,14"/>

                                    <ProgressBar x:Name="ProgDownload" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="#10B981" Background="{DynamicResource BrushMainBg}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtDownloadStatus" Text="Ready to download" FontSize="12" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="3" Background="{DynamicResource BrushPanelBg}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="Ready — ModelStudio IDE v1.0.0 Pro" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Text="Barrer Software © 2026" FontSize="12" Foreground="#6B7280" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
